# Copy to .env and fill in. Never commit .env.
# Generate real secrets with:
#   openssl rand -hex 32   -> JWT_SECRET
#   openssl rand -hex 24   -> ADMIN_API_KEY

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/seats
JWT_SECRET=change-me
ADMIN_API_KEY=change-me

WEB_CONCURRENCY=4
DB_POOL_MIN=8
DB_POOL_MAX=8
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=5000
DEFAULT_PER_USER_LIMIT=4
LOG_LEVEL=INFO
LOG_REQUEST_LINES_PER_SECOND=50
